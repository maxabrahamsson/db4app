{
  "name": "db4app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspace=@db4app/client-sdk && tsc -b && vite build",
    "build:mcp": "cd packages/mcp-server-db4app && npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "relay": "node server/index.js",
    "proxy": "npm run relay",
    "test:load:websocket": "artillery run load-tests/browser-websocket-test.yml",
    "test:load:websocket:local": "artillery run load-tests/browser-websocket-test.yml --target ws://localhost:8787"
  },
  "dependencies": {
    "@db4app/client-sdk": "*",
    "@electric-sql/pglite": "^0.3.15",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/react": "^10.26.0",
    "ag-grid-community": "^34.3.1",
    "ag-grid-react": "^34.3.1",
    "monaco-editor": "^0.55.1",
    "posthog-js": "^1.297.0",
    "posthog-node": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "pg": "^8.17.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "uuid": "^13.0.0",
    "vite": "^7.2.2"
  },
  "optionalDependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-fs": "^2.4.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.27.2": true,
    "esbuild@0.24.2": true
  }
}
