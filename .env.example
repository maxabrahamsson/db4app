# =============================================================================
# db4app environment variables
# Copy to .env.local (frontend) / .env (relay) and adjust. All values are
# placeholders; nothing here is required for browser-only use.
# =============================================================================

# -----------------------------------------------------------------------------
# Relay server (server/index.js)
# -----------------------------------------------------------------------------

# Allowed CORS origins (comma-separated): the origin(s) serving the web UI
ALLOWED_ORIGINS=http://localhost:5173,https://db4.example.com

# Optional: Override relay ports (defaults shown)
RELAY_PORT=8787
RELAY_PG_PORT=6543
RELAY_TIMEOUT=15000

# Legacy variables (optional, still supported)
PROXY_PORT=8787
PROXY_PG_PORT=6543
PROXY_TIMEOUT=15000

# Optional: Cloudflare Tunnel token, if you expose your relay via a tunnel
# TUNNEL_TOKEN=your-tunnel-token-here

# -----------------------------------------------------------------------------
# Frontend (Vite, read at build time)
# -----------------------------------------------------------------------------
# There is no hosted relay. If none of these are set, the web UI connects to a
# self-hosted relay on this machine: ws://localhost:8787/agent (Postgres port 6543).
# Users can also set a custom relay URL at runtime on the Database page.

# Full WebSocket URL of the relay's agent endpoint (takes precedence over HOST/PORT)
# VITE_RELAY_AGENT_URL=wss://relay.example.com/agent

# Or set host/ports and let the URLs be derived
# (non-localhost hosts use wss/https with no port)
# VITE_RELAY_HOST=relay.example.com
# VITE_RELAY_PORT=8787
# VITE_RELAY_PG_PORT=6543

# Optional: explicit HTTP query endpoint
# VITE_RELAY_HTTP_URL=https://relay.example.com/query

# Optional: connection string shown to users (overrides the derived one)
# VITE_RELAY_CONNECTION_STRING=psql "host=relay.example.com port=6543 user=postgres"

# Legacy aliases (still read): VITE_PROXY_AGENT_URL, VITE_PROXY_HOST, VITE_PROXY_PORT,
# VITE_PROXY_PG_PORT, VITE_PROXY_HTTP_URL, VITE_PROXY_CONNECTION_STRING

# -----------------------------------------------------------------------------
# Telemetry (opt-in; disabled unless set)
# -----------------------------------------------------------------------------

# PostHog: analytics is only initialized when BOTH key and host are set
# VITE_PUBLIC_POSTHOG_KEY=phc_your_project_key
# VITE_PUBLIC_POSTHOG_HOST=https://your-posthog-host.example.com

# Sentry: error reporting is only initialized when a DSN is set
# VITE_SENTRY_DSN=https://your-key@your-sentry-host.example.com/your-project-id
